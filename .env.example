# Copy to .env for local testing. NEVER commit .env. In production, set these in
# the Render / Cloudflare dashboards instead.

# --- Backend (Render) ---
# Comma-separated list of frontend origins allowed to call the API.
QNT_ALLOWED_ORIGINS=https://quantlab.pages.dev
QNT_MODELS_DIR=/data/models

# --- Cloudflare R2 (S3-compatible). Leave empty to use local-disk mode. ---
QNT_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
QNT_S3_BUCKET=quantlab-models
QNT_S3_ACCESS_KEY_ID=
QNT_S3_SECRET_ACCESS_KEY=
QNT_S3_REGION=auto

# --- Frontend (Cloudflare Pages build variable; public, not a secret) ---
VITE_API_URL=https://quantlab-api.onrender.com
